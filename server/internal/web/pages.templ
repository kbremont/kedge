package web

import (
	"fmt"

	"github.com/kbremont/kedge/server/internal/training"
)

templ Dashboard(d training.Dashboard) {
	@Layout("Today", NavHome) {
		for _, t := range d.TestResults {
			@tmTestResult(t)
		}
		if d.Review != nil {
			@tmReview(*d.Review)
		}
		if d.Next != nil {
			@nextUpCard(*d.Next, d.Unit)
		} else {
			<div class="card empty">Nothing scheduled. Check your program in settings.</div>
		}
		<h2>Training maxes</h2>
		<div class="card">
			for i, tm := range d.TMs {
				if i > 0 {
					<div style="height:1px;background:var(--border);margin:10px 0"></div>
				}
				<a class="row" style="text-decoration:none;color:inherit" href={ templ.URL("/lift/" + tm.Slug) }>
					<span>{ tm.Name }</span>
					<span class="tnum muted">{ FmtWeightUnit(tm.Value, d.Unit) } &rsaquo;</span>
				</a>
			}
		</div>
		if len(d.Recent) > 0 {
			<h2>Recent</h2>
			<div class="card">
				for _, h := range d.Recent {
					<a class="hist" href={ templ.URL(fmt.Sprintf("/workout/%d", h.WorkoutID)) }>
						<span>
							{ h.LiftName }
							<span class="muted small">&nbsp;{ h.CycleLabel }</span>
						</span>
						<span class="muted small tnum">{ h.Summary }</span>
					</a>
				}
			</div>
		}
	}
}

templ nextUpCard(n training.NextUp, unit string) {
	<div class="card next" style="margin-top:20px">
		<div class="eyebrow">
			if n.InProgress {
				In progress
			} else {
				Next up
			}
		</div>
		<div class="lift">{ n.LiftName }</div>
		<div class="muted small tnum" style="margin-bottom:16px">
			{ n.CycleLabel } &middot; TM { FmtWeightUnit(n.TrainingMax, unit) }
			<br/>
			Block { FmtInt(n.BlockNumber) } &middot; round { FmtInt(n.RoundOfBlock) } of { FmtInt(n.RoundsInBlock) }
		</div>
		if n.InProgress {
			<a class="btn btn-primary" href={ templ.URL(fmt.Sprintf("/workout/%d", n.WorkoutID)) }>Resume session</a>
		} else if n.Blocked {
			<div class="small muted">Settle your training maxes above to start.</div>
		} else {
			<form method="post" action="/workout/start">
				<button class="btn btn-primary" type="submit">Start session</button>
			</form>
			if n.CanSkip {
				<form method="post" action="/skip-cycle" style="margin-top:8px">
					<button class="btn btn-ghost" type="submit">Skip it and start the next block</button>
				</form>
			}
		}
	</div>
}

// tmTestResult reports one lift's TM test as soon as it is done. A failed test
// offers to lower the training max; keeping it is a choice too, and either one
// settles it. Nothing is written until a button is pressed.
templ tmTestResult(t training.TMTestResult) {
	<div class="notice" style="margin-top:20px">
		<div class="row">
			<strong>{ t.LiftName } TM test</strong>
			<span class="small muted tnum">{ FmtWeight(t.Tested) } x { FmtInt(t.Reps) } at 100%</span>
		</div>
		<div class={ "verdict", "verdict-" + t.Tone } style="margin-top:6px">{ t.Headline }</div>
		<div class="small muted" style="margin-top:2px">{ t.Detail }</div>
		if t.NeedsDecision {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/tm-test/%d", t.WorkoutID)) } style="margin-top:12px">
				<label for={ fmt.Sprintf("tm-%d", t.WorkoutID) }>New training max (now { FmtWeightUnit(t.Current, t.Unit) })</label>
				<input
					id={ fmt.Sprintf("tm-%d", t.WorkoutID) }
					type="number"
					name="tm"
					step="0.5"
					min="1"
					max={ FmtWeight(t.Current) }
					inputmode="decimal"
					required
					value={ FmtWeight(t.Proposed) }
				/>
				<button class="btn btn-primary" type="submit" name="action" value="lower" style="margin-top:12px">Lower training max</button>
				<button class="btn btn-ghost" type="submit" name="action" value="keep" formnovalidate style="margin-top:8px">Keep { FmtWeightUnit(t.Current, t.Unit) }</button>
			</form>
		}
	</div>
}

// tmReview asks the user to settle every training max at once. The proposed
// values are only a starting point: nothing is written until Accept, and what
// is written is whatever the inputs hold at that moment.
templ tmReview(r training.TMReview) {
	<div class="notice" style="margin-top:20px">
		<strong>{ r.Title }</strong>
		<div class="small muted" style="margin:4px 0 4px">{ r.Intro }</div>
		<form method="post" action="/tm-review">
			<input type="hidden" name="key" value={ r.Key }/>
			for _, row := range r.Rows {
				<div class="review-row">
					<div class="row">
						<span>{ row.Name }</span>
						<span class={ "verdict", "verdict-" + row.Tone }>{ row.Verdict }</span>
					</div>
					<div class="small muted tnum" style="margin:2px 0 8px">{ row.Evidence }</div>
					<label for={ tmField(row.Slug) }>Now { FmtWeightUnit(row.Current, r.Unit) } &middot; new training max</label>
					<input
						id={ tmField(row.Slug) }
						type="number"
						name={ tmField(row.Slug) }
						step="0.5"
						min="1"
						inputmode="decimal"
						required
						value={ FmtWeight(row.Proposed) }
					/>
				</div>
			}
			<button class="btn btn-primary" type="submit" style="margin-top:14px">Accept training maxes</button>
		</form>
	</div>
}

templ History(h training.History) {
	@Layout("History", NavHistory) {
		<h2>By lift</h2>
		<div class="card">
			for i, l := range h.Lifts {
				if i > 0 {
					<div style="height:1px;background:var(--border);margin:10px 0"></div>
				}
				<a class="row" style="text-decoration:none;color:inherit" href={ templ.URL("/lift/" + l.Slug) }>
					<span>{ l.Name }</span>
					<span class="muted">&rsaquo;</span>
				</a>
			}
		</div>
		<h2>Completed sessions</h2>
		if len(h.Items) == 0 {
			<div class="card empty">No sessions yet.</div>
		} else {
			<div class="card">
				for _, it := range h.Items {
					<a class="hist" href={ templ.URL(fmt.Sprintf("/workout/%d", it.WorkoutID)) }>
						<span>
							{ it.LiftName }
							<span class="muted small">&nbsp;{ it.CycleLabel }</span>
						</span>
						<span class="muted small tnum">{ it.Date } &middot; { it.Summary }</span>
					</a>
				}
			</div>
		}
	}
}

templ LiftDetail(l LiftPage) {
	@Layout(l.Name, NavHistory) {
		<div style="margin-top:20px">
			<div class="next">
				<div class="lift">{ l.Name }</div>
				<div class="muted small tnum">
					Training max { FmtWeightUnit(l.CurrentTM, l.Unit) }
					if l.BestE1RM > 0 {
						&middot; best estimated max { FmtWeightUnit(l.BestE1RM, l.Unit) }
					}
				</div>
			</div>
		</div>
		<h2>Estimated max from PR sets</h2>
		if len(l.Points) == 0 {
			<div class="card empty">
				Not enough data yet. The TM test and the anchor's PR sets add
				points as you train, and you can add estimates from before the
				app below.
			</div>
		} else {
			<div class="card">
				@chart(l.Lift)
			</div>
		}
		// The add form waits behind a plus in the heading. <details> opens and
		// closes it without a script, and a rejected entry reopens it so the
		// error is in view.
		<details class="past-estimates" open?={ l.Error }>
			<summary>
				<h2>Past estimates</h2>
				<span class="plus" aria-hidden="true"><span>+</span></span>
			</summary>
			<div class="card" style="margin-bottom:12px">
				if l.Error {
					<div class="error">That estimate was not saved. Check the date, weight and reps.</div>
				}
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/lift/%s/estimates", l.Slug)) }>
					<div class="field">
						<label for="recorded_on">Date</label>
						<input id="recorded_on" type="date" name="recorded_on" max={ l.Today } required/>
					</div>
					<div class="field">
						<label for="weight">Weight ({ l.Unit })</label>
						<input id="weight" type="number" name="weight" step="0.5" min="1" inputmode="decimal" required/>
					</div>
					<div class="field">
						<label for="reps">Reps</label>
						<input id="reps" type="number" name="reps" value="1" min="1" max="30" inputmode="numeric" required/>
					</div>
					<div class="small muted" style="margin-bottom:12px">
						Enter an estimated max as weight &times; 1, or a PR set like 135 &times; 8.
						These count toward your best estimated max but never change a
						training max or a TM test.
					</div>
					<button class="btn" type="submit">Add estimate</button>
				</form>
			</div>
		</details>
		if len(l.PastEstimates) > 0 {
			<div class="card">
				for i, e := range l.PastEstimates {
					if i > 0 {
						<div style="height:1px;background:var(--border);margin:10px 0"></div>
					}
					<div class="row">
						<span class="tnum">
							{ e.Date } &middot; { FmtWeight(e.Weight) } x { FmtInt(e.Reps) }
							<span class="muted small">&middot; est. { FmtWeightUnit(e.Estimate, l.Unit) }</span>
						</span>
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/lift/%s/estimates/%d/delete", l.Slug, e.ID)) }>
							<button class="btn btn-ghost" type="submit" style="width:auto;padding:0 10px">Delete</button>
						</form>
					</div>
				}
			</div>
		}
		<h2>Training max history</h2>
		<div class="card">
			for i, t := range l.TMHistory {
				if i > 0 {
					<div style="height:1px;background:var(--border);margin:10px 0"></div>
				}
				<div class="row">
					<span class="tnum">{ FmtWeightUnit(t.Value, l.Unit) }</span>
					<span class="muted small">
						{ t.Date }
						if t.Note != "" {
							&middot; { t.Note }
						}
					</span>
				</div>
			}
		</div>
	}
}

templ chart(l training.Lift) {
	<svg class="chart" viewBox="0 0 320 160" preserveAspectRatio="none" role="img" aria-label="Estimated one rep max over time">
		<line class="grid" x1="0" y1="130" x2="320" y2="130"></line>
		<line class="grid" x1="0" y1="70" x2="320" y2="70"></line>
		<line class="grid" x1="0" y1="10" x2="320" y2="10"></line>
		<path class="line" d={ l.Path }></path>
		for _, p := range l.Points {
			if p.Past {
				<circle class="dot past" cx={ FmtWeight(p.X) } cy={ FmtWeight(p.Y) } r="3.5"></circle>
			} else {
				<circle class="dot" cx={ FmtWeight(p.X) } cy={ FmtWeight(p.Y) } r="3.5"></circle>
			}
		}
		// With nothing to compare against yet, say what the one point is.
		if len(l.Points) == 1 {
			<text class="lbl" x={ FmtWeight(l.Points[0].X) } y={ FmtWeight(l.Points[0].Y - 10) } text-anchor="middle">{ l.Points[0].Label }</text>
		}
		<text class="lbl" x="2" y="146">{ FmtWeight(l.YMin) }</text>
		<text class="lbl" x="2" y="8">{ FmtWeight(l.YMax) }</text>
	</svg>
}

templ Settings(s SettingsPage) {
	@Layout("Settings", NavSettings) {
		if s.Saved {
			<div class="notice" style="margin-top:20px">Saved.</div>
		}
		<h2>Training maxes</h2>
		<div class="card">
			<div class="small muted" style="margin-bottom:12px">
				Changing a training max affects future sessions only. Completed
				work keeps the weights it was performed at.
			</div>
			for _, tm := range s.TMs {
				<form method="post" action="/training-max" class="inline-form" style="margin-bottom:10px">
					<input type="hidden" name="lift" value={ tm.Slug }/>
					<div class="field">
						<label>{ tm.Name }</label>
						<input type="number" name="value" step="0.5" inputmode="decimal" value={ FmtWeight(tm.Value) }/>
					</div>
					<button class="btn" type="submit">Save</button>
				</form>
			}
		</div>
		<form method="post" action="/settings">
			<h2>Loading</h2>
			<div class="card">
				<div class="field">
					<label for="bar">Bar weight ({ s.Unit })</label>
					<input id="bar" type="number" name="bar_weight" step="0.5" inputmode="decimal" value={ FmtWeight(s.BarWeight) }/>
				</div>
				<div class="field">
					<label for="rounding">Round weights to ({ s.Unit })</label>
					<input id="rounding" type="number" name="rounding" step="0.5" inputmode="decimal" value={ FmtWeight(s.Rounding) }/>
				</div>
				<div class="field">
					<label for="plates">Plates available, per side</label>
					<input id="plates" type="text" name="plates" inputmode="decimal" value={ FmtPlateList(s.Plates) }/>
				</div>
				<div class="field">
					<label>
						if s.Warmups {
							<input type="checkbox" name="warmups" value="1" checked/>
						} else {
							<input type="checkbox" name="warmups" value="1"/>
						}
						&nbsp;Include 40/50/60 warmup sets
					</label>
				</div>
			</div>
			<h2>Rest timers</h2>
			<div class="card">
				<div class="field">
					<label for="rest-warmup">Between warmups (seconds)</label>
					<input id="rest-warmup" type="number" name="rest_warmup_seconds" inputmode="numeric" value={ FmtInt(s.RestWarmupSeconds) }/>
				</div>
				<div class="field">
					<label for="rest-main">Between main sets (seconds)</label>
					<input id="rest-main" type="number" name="rest_main_seconds" inputmode="numeric" value={ FmtInt(s.RestMainSeconds) }/>
				</div>
				<div class="field">
					<label for="rest-supp">Between supplemental sets (BBB and FSL) (seconds)</label>
					<input id="rest-supp" type="number" name="rest_supp_seconds" inputmode="numeric" value={ FmtInt(s.RestSuppSeconds) }/>
				</div>
			</div>
			<h2>Supplemental (BBB)</h2>
			<div class="card">
				<div class="small muted" style="margin-bottom:12px">
					The program default is used when the mode is "Program default".
				</div>
				for _, b := range s.BBB {
					<div class="inline-form" style="margin-bottom:10px">
						<div class="field">
							<label>{ b.Name }</label>
							<select name={ bbbModeField(b.Slug) }>
								<option value="program" selected?={ b.Mode == "program" }>Program default</option>
								<option value="percent" selected?={ b.Mode == "percent" }>Percent of training max</option>
								<option value="weight" selected?={ b.Mode == "weight" }>Fixed weight</option>
							</select>
						</div>
						<div class="field">
							<label for={ "bbb-value-" + b.Slug }>Value</label>
							<input id={ "bbb-value-" + b.Slug } type="number" name={ bbbValueField(b.Slug) } step="0.5" inputmode="decimal" value={ FmtWeight(b.Value) }/>
						</div>
					</div>
				}
			</div>
			<button class="btn btn-primary" type="submit">Save settings</button>
		</form>
		<h2>Data</h2>
		<div class="card">
			<div class="small muted" style="margin-bottom:12px">
				Downloads a consistent snapshot of the database. Safe to run while
				the app is in use.
			</div>
			<a class="btn" href="/backup">Download backup</a>
		</div>
		<h2>Session</h2>
		<form method="post" action="/logout">
			<button class="btn btn-ghost" type="submit">Sign out</button>
		</form>
	}
}

templ Login(errMsg string) {
	@Bare("Sign in") {
		<div class="next" style="margin-bottom:20px">
			<div class="lift">5/3/1</div>
			<div class="muted small">Sign in to continue.</div>
		</div>
		if errMsg != "" {
			<div class="error">{ errMsg }</div>
		}
		<form method="post" action="/login">
			<div class="card">
				<div class="field">
					<label for="password">Password</label>
					<input id="password" type="password" name="password" autocomplete="current-password" autofocus/>
				</div>
			</div>
			<button class="btn btn-primary" type="submit">Sign in</button>
		</form>
	}
}

templ Setup(s SetupPage) {
	@Bare("Set up") {
		<div class="next" style="margin-bottom:16px">
			<div class="lift">Training maxes</div>
			<div class="muted small">
				Start at 90% of a recent, honest one rep max. If in doubt, go lower.
				You can change these at any time.
			</div>
		</div>
		if s.Error != "" {
			<div class="error">{ s.Error }</div>
		}
		<form method="post" action="/setup">
			<div class="card">
				for _, l := range s.Lifts {
					<div class="field">
						<label for={ "tm-" + l.Slug }>{ l.Name } ({ s.Unit })</label>
						<input
							id={ "tm-" + l.Slug }
							type="number"
							name={ tmField(l.Slug) }
							step="0.5"
							inputmode="decimal"
							required
							if l.Value > 0 {
								value={ FmtWeight(l.Value) }
							}
						/>
					</div>
				}
			</div>
			<button class="btn btn-primary" type="submit">Start training</button>
		</form>
	}
}

// SetupPosition asks which cycle the user is currently on. The options come
// from the program config, so renaming or reordering cycles needs no change
// here.
templ SetupPosition(vm training.SetupPosition) {
	@Bare("Where are you?") {
		<div class="next" style="margin-bottom:16px">
			<div class="lift">Where are you?</div>
			<div class="muted small">
				Pick the cycle you are on now. Anything before it is left out of this
				block entirely, so you do not have to enter old history.
			</div>
		</div>
		<form method="post" action="/setup/position">
			<div class="card">
				<label style="margin-bottom:14px">
					<input type="radio" name="cycle" value="fresh" checked/>
					&nbsp;Starting fresh at the beginning
				</label>
				for _, c := range vm.Cycles {
					<div style="height:1px;background:var(--border);margin:10px 0"></div>
					<label style="margin-bottom:0">
						<input type="radio" name="cycle" value={ FmtInt(c.Index) }/>
						&nbsp;{ c.Label }
						<span class="muted small">&nbsp;{ c.Detail }</span>
					</label>
				}
			</div>
			<button class="btn btn-primary" type="submit">Continue</button>
		</form>
	}
}

// SetupHistory records which sessions of the chosen cycle are already done.
templ SetupHistory(vm training.SetupHistory) {
	@Bare("What have you done?") {
		<div class="next" style="margin-bottom:16px">
			<div class="lift">{ vm.CycleLabel }</div>
			<div class="muted small">
				Tick the sessions you have already finished. The first one you leave
				unticked is where the app will pick up.
			</div>
		</div>
		<form method="post" action="/setup/history">
			<input type="hidden" name="cycle" value={ FmtInt(vm.CycleIndex) }/>
			for _, rd := range vm.Rounds {
				if len(vm.Rounds) > 1 {
					<h2>Round { FmtInt(rd.Round) }</h2>
				}
				<div class="card">
					for i, d := range rd.Days {
						if i > 0 {
							<div style="height:1px;background:var(--border);margin:10px 0"></div>
						}
						<label style="margin-bottom:0">
							<input type="checkbox" name={ doneField(rd.Round, d.Slug) } value="1"/>
							&nbsp;{ d.Name }
							<span class="muted small tnum">
								&nbsp;top set { FmtWeightUnit(d.TopWeight, vm.Unit) }
							</span>
						</label>
						if vm.AsksReps {
							<div class="field" style="margin-top:8px;margin-bottom:0">
								<label for={ repsField(rd.Round, d.Slug) }>{ vm.RepsLabel }</label>
								<input
									id={ repsField(rd.Round, d.Slug) }
									type="number"
									name={ repsField(rd.Round, d.Slug) }
									inputmode="numeric"
									min="1"
									max="100"
									placeholder={ FmtInt(d.PRTarget) }
								/>
							</div>
						}
					}
				</div>
			}
			<button class="btn btn-primary" type="submit">Save and start</button>
		</form>
	}
}
