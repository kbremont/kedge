package views

import "fmt"

// AssetVersion is appended to static asset URLs so a deploy busts the cache.
var AssetVersion = "dev"

templ Layout(title string, nav Nav) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="theme-color" content="#0d0f12"/>
			<meta name="color-scheme" content="dark"/>
			<!-- Standalone display and an icon are all the manifest needs to make
			     this installable; offline would require a service worker. -->
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
			<meta name="apple-mobile-web-app-title" content="5/3/1"/>
			<link rel="manifest" href="/manifest.webmanifest"/>
			<link rel="apple-touch-icon" href={ templ.URL("/static/icon-180.png?v=" + AssetVersion) }/>
			<link rel="icon" href={ templ.URL("/static/icon-192.png?v=" + AssetVersion) }/>
			<link rel="stylesheet" href={ templ.URL("/static/app.css?v=" + AssetVersion) }/>
			<title>{ title }</title>
		</head>
		<body>
			@appHeader(nav)
			<main class="wrap">
				{ children... }
			</main>
		</body>
	</html>
}

templ appHeader(nav Nav) {
	<header class="app">
		<div class="bar">
			<h1>5/3/1</h1>
			<nav class="app">
				@navLink("/", "Today", nav == NavHome)
				@navLink("/history", "History", nav == NavHistory)
				@navLink("/settings", "Settings", nav == NavSettings)
			</nav>
		</div>
	</header>
}

templ navLink(href, label string, current bool) {
	if current {
		<a href={ templ.URL(href) } aria-current="page">{ label }</a>
	} else {
		<a href={ templ.URL(href) }>{ label }</a>
	}
}

// Bare is the layout for screens shown before sign-in or setup, with no nav.
templ Bare(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="theme-color" content="#0d0f12"/>
			<meta name="color-scheme" content="dark"/>
			<link rel="manifest" href="/manifest.webmanifest"/>
			<link rel="apple-touch-icon" href={ templ.URL("/static/icon-180.png?v=" + AssetVersion) }/>
			<link rel="stylesheet" href={ templ.URL("/static/app.css?v=" + AssetVersion) }/>
			<title>{ title }</title>
		</head>
		<body>
			<main class="wrap" style="padding-top:48px">
				{ children... }
			</main>
		</body>
	</html>
}

// restStyle sets the countdown duration. It is emitted as a style element
// rather than an inline attribute so the animation stays entirely in CSS.
func restStyle(seconds int) string {
	return fmt.Sprintf("<style>.rest-fill{animation-duration:%ds}</style>", seconds)
}
