package views

import "fmt"

templ Workout(w WorkoutVM) {
	@Layout(w.LiftName, NavHome) {
		@templ.Raw(restStyle(w.RestSeconds))
		<div style="margin-top:20px">
			<div class="next">
				<div class="eyebrow">{ w.CycleLabel }</div>
				<div class="lift">{ w.LiftName }</div>
				<div class="muted small tnum">
					Training max { FmtWeightUnit(w.TrainingMax, w.Unit) }
				</div>
			</div>
		</div>
		if w.ShowRest && w.CurrentIdx >= 0 {
			@restTimer(w.RestSeconds)
		}
		<div style="margin-top:16px">
			for _, s := range w.Sets {
				@setRow(w, s)
			}
		</div>
		if w.Completed {
			<div class="notice" style="margin-top:20px">Session complete.</div>
		} else if w.CurrentIdx < 0 {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/workout/%d/finish", w.ID)) } style="margin-top:20px">
				<button class="btn btn-primary" type="submit">Finish session</button>
			</form>
		} else {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/workout/%d/abandon", w.ID)) } style="margin-top:28px">
				<button class="btn btn-ghost btn-danger" type="submit">Discard this session</button>
			</form>
		}
	}
}

templ restTimer(seconds int) {
	<div class="rest">
		<div class="row">
			<span class="small muted">Rest</span>
			<span class="small muted tnum">{ FmtInt(seconds) }s</span>
		</div>
		<div class="rest-track"><div class="rest-fill"></div></div>
	</div>
}

templ setRow(w WorkoutVM, s SetVM) {
	if s.Done {
		@doneSet(w, s)
	} else if s.Idx == w.CurrentIdx {
		@currentSet(w, s)
	} else {
		@upcomingSet(w, s)
	}
}

templ doneSet(w WorkoutVM, s SetVM) {
	<div class="set done" id={ fmt.Sprintf("set-%d", s.Idx) }>
		<div class="set-info">
			<span class="set-weight">{ FmtWeight(s.Weight) }</span>
			<span class="set-meta">&times; { FmtInt(s.ActualReps) }</span>
		</div>
		<form method="post" action={ templ.SafeURL(fmt.Sprintf("/workout/%d/set/%d/undo", w.ID, s.Idx)) }>
			<button class="undo" type="submit">Undo</button>
		</form>
	</div>
}

templ upcomingSet(w WorkoutVM, s SetVM) {
	<div class="set" id={ fmt.Sprintf("set-%d", s.Idx) }>
		<div class="set-info">
			<div class="set-tag">{ s.Tag }</div>
			<div class="set-weight">{ FmtWeightUnit(s.Weight, w.Unit) }</div>
			<div class="set-meta">
				{ RepTarget(s.TargetReps, s.IsAMRAP) } reps &middot; { FmtPct(s.Pct) }
			</div>
		</div>
	</div>
}

templ currentSet(w WorkoutVM, s SetVM) {
	<div class="set current" id={ fmt.Sprintf("set-%d", s.Idx) }>
		<div class="set-info">
			<div class="set-tag">{ s.Tag }</div>
			<div class="set-weight">{ FmtWeightUnit(s.Weight, w.Unit) }</div>
			<div class="set-meta">
				{ RepTarget(s.TargetReps, s.IsAMRAP) } reps &middot; { FmtPct(s.Pct) }
			</div>
			@plateLine(s, w.Unit)
		</div>
		if !s.IsAMRAP {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/workout/%d/set/%d", w.ID, s.Idx)) }>
				<input type="hidden" name="reps" value={ FmtInt(s.TargetReps) }/>
				<button class="check" type="submit" aria-label="Log set">&check;</button>
			</form>
		}
	</div>
	if s.IsAMRAP {
		@amrapPicker(w, s)
	}
}

templ plateLine(s SetVM, unit string) {
	if s.Plates != "" {
		<div class="plates">
			Bar + { s.Plates } per side
			if s.Unloadable != 0 {
				<span class="warn">({ FmtWeightUnit(s.Unloadable, unit) } short)</span>
			}
		</div>
	} else {
		<div class="plates">Empty bar</div>
	}
}

// amrapPicker replaces a stepper with one tap per plausible answer, so the PR
// set can be logged without a keyboard.
templ amrapPicker(w WorkoutVM, s SetVM) {
	<div class="card">
		<div class="amrap-prompt">
			How many reps?
			if w.BestE1RM > 0 {
				<span class="tnum">Best estimated max { FmtWeightUnit(w.BestE1RM, w.Unit) }.</span>
			}
		</div>
		<form method="post" action={ templ.SafeURL(fmt.Sprintf("/workout/%d/set/%d", w.ID, s.Idx)) }>
			<div class="reps">
				for _, r := range repChoices(s.TargetReps) {
					if r == s.TargetReps {
						<button class="target" type="submit" name="reps" value={ FmtInt(r) }>{ FmtInt(r) }</button>
					} else {
						<button type="submit" name="reps" value={ FmtInt(r) }>{ FmtInt(r) }</button>
					}
				}
			</div>
		</form>
		<form method="post" action={ templ.SafeURL(fmt.Sprintf("/workout/%d/set/%d", w.ID, s.Idx)) } class="inline-form" style="margin-top:12px">
			<div class="field">
				<label for="more-reps">More</label>
				<input id="more-reps" type="number" name="reps" inputmode="numeric" min="1" max="100"/>
			</div>
			<button class="btn" type="submit">Log</button>
		</form>
	</div>
}

// repChoices offers ten answers starting at the prescribed target, which
// covers all but the most exceptional PR set.
func repChoices(target int) []int {
	if target < 1 {
		target = 1
	}
	out := make([]int, 10)
	for i := range out {
		out[i] = target + i
	}
	return out
}
