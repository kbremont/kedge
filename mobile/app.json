{
  "expo": {
    "name": "Kedge",
    "slug": "kedge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/icon-light.png",
    "scheme": "kedge",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/kedge.icon",
      "bundleIdentifier": "sh.lyle.kedge",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Kedge connects to your 5/3/1 server on your own network."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#C9C3B7",
          "image": "./assets/splash/splash-light.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#121729",
            "image": "./assets/splash/splash-dark.png"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
